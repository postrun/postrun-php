{
    "name": "postrun/postrun-php",
    "description": "PHP SDK for the PostRun email delivery API",
    "type": "library",
    "license": "MIT",
    "keywords": ["postrun", "email", "api", "sdk"],
    "authors": [
        {
            "name": "PostRun",
            "email": "support@postrun.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "PostRun\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PostRun\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
